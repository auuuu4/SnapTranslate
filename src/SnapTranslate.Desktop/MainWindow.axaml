<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="680"
        x:Class="SnapTranslate.Desktop.MainWindow"
        Title="SnapTranslate" Width="900" Height="680"
        MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="66,*,30" Background="{StaticResource PageBrush}">
    <Border Grid.Row="0" Background="{StaticResource InkBrush}">
      <Grid Margin="24,0" ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="SnapTranslate" FontSize="22" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="macOS 桌面版" FontSize="11" Foreground="#B9C0C5" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="翻译 · OCR · 文档" VerticalAlignment="Center"
                   Foreground="#D7DDE0" FontSize="12" />
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16" Background="Transparent">
      <TabItem Header="输入翻译">
        <Grid Margin="10,14,10,6" RowDefinitions="*,Auto,*">
          <TextBox x:Name="InputText" AcceptsReturn="True" TextWrapping="Wrap"
                   Watermark="输入需要翻译的文本" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          <Grid Grid.Row="1" Margin="0,8" ColumnDefinitions="Auto,150,*,Auto,Auto,Auto">
            <TextBlock Text="目标语言" VerticalAlignment="Center" Margin="4,0,8,0" />
            <ComboBox x:Name="QuickTargetCombo" Grid.Column="1" SelectedIndex="0">
              <ComboBoxItem Content="自动" Tag="auto" />
              <ComboBoxItem Content="简体中文" Tag="zh-CN" />
              <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <Button Grid.Column="3" Content="清空" Click="ClearInput_Click" Margin="4,0" />
            <Button Grid.Column="4" Content="复制结果" Click="CopyInputResult_Click" Margin="4,0" />
            <Button x:Name="TranslateButton" Grid.Column="5" Classes="accent" Content="翻译"
                    Click="TranslateInput_Click" MinWidth="88" Margin="4,0" />
          </Grid>
          <TextBox x:Name="InputResultText" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                   IsReadOnly="True" Watermark="翻译结果" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
      </TabItem>

      <TabItem Header="截图">
        <Grid Margin="24" RowDefinitions="*,Auto,Auto,*">
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="10" MaxWidth="460">
            <TextBlock Text="截图与 OCR" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       Text="框选后可以标注、复制、保存、贴图、OCR 或翻译。首次使用需要在「系统设置 → 隐私与安全性 → 屏幕录制」里允许本应用。" />
          </StackPanel>
          <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Classes="accent" Content="截图" Click="Capture_Click" Margin="5" MinWidth="110" />
            <Button Content="截图翻译" Click="CaptureTranslate_Click" Margin="5" MinWidth="110" />
            <Button Content="截图 OCR" Click="CaptureOcr_Click" Margin="5" MinWidth="110" />
            <Button Content="静默 OCR" Click="SilentOcr_Click" Margin="5" MinWidth="110" />
            <Button Content="剪贴板历史" Click="OpenClipboard_Click" Margin="5" MinWidth="110" />
          </WrapPanel>
          <TextBlock x:Name="ScreenshotStatus" Grid.Row="3" Margin="0,18,0,0"
                     HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" />
        </Grid>
      </TabItem>

      <TabItem Header="文档任务">
        <Grid Margin="10,14,10,6" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <TextBlock x:Name="DocumentTaskCountText" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <Button Grid.Column="1" Content="清除已结束" Click="ClearCompletedDocumentTasks_Click" Margin="4,0" />
            <Button Grid.Column="2" Classes="accent" Content="添加文件" Click="AddDocumentFiles_Click" Margin="4,0" />
          </Grid>
          <ListBox x:Name="DocumentTaskList" Grid.Row="1" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="2*,70,120,2*,Auto,Auto" Margin="8,7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SourcePath}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Format}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="8" />
                    <TextBlock Text="{Binding ProgressDisplay}" FontSize="11" HorizontalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="10,0" />
                  <Button Grid.Column="4" Content="打开" Click="OpenDocumentOutput_Click"
                          IsEnabled="{Binding CanOpen}" Margin="3,0" />
                  <Button Grid.Column="5" Classes="danger" Content="取消" Click="CancelDocumentTask_Click"
                          IsEnabled="{Binding CanCancel}" Margin="3,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="历史">
        <Grid Margin="10,14,10,6" RowDefinitions="*,Auto">
          <ListBox x:Name="HistoryList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="110,2*,2*,120" Margin="8,7">
                  <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Source}" TextTrimming="CharacterEllipsis"
                             TextWrapping="Wrap" MaxLines="2" MaxHeight="38" Margin="8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Translation}" TextTrimming="CharacterEllipsis"
                             TextWrapping="Wrap" MaxLines="2" MaxHeight="38" Margin="8,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Provider}" Foreground="{StaticResource MutedBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="复制译文" Click="CopyHistory_Click" />
            <Button Classes="danger" Content="清空历史" Click="ClearHistory_Click" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,18" Spacing="14" MaxWidth="780" HorizontalAlignment="Left">

            <TextBlock Text="翻译方式" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Text="通道" VerticalAlignment="Center" />
              <ComboBox x:Name="ProviderCombo" Grid.Row="0" Grid.Column="1" Margin="0,4" />
              <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         Text="「自动」会按内置顺序依次尝试；其余选项只走对应的单一通道。" />
            </Grid>

            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBlock Text="自定义 API 渠道" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="新建" Click="NewChatProfile_Click" Margin="4,0" />
                  <Button Grid.Column="2" Classes="danger" Content="删除" Click="DeleteChatProfile_Click" Margin="4,0" />
                  <Button Grid.Column="3" Content="设为当前" Click="ActivateChatProfile_Click" Margin="4,0" />
                </Grid>
                <ListBox x:Name="ChatProfileList" Height="110" SelectionChanged="ChatProfileList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding FormatDisplay}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ActiveProfileText" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="当前渠道：（未选择）" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Text="渠道名称" VerticalAlignment="Center" Margin="0,4" />
                  <TextBox x:Name="ChatProfileNameText" Grid.Row="0" Grid.Column="1" Margin="0,4" />
                  <TextBlock Grid.Row="1" Text="接口地址" VerticalAlignment="Center" Margin="0,4" />
                  <TextBox x:Name="ChatProfileBaseUrlText" Grid.Row="1" Grid.Column="1" Margin="0,4"
                           Watermark="https://api.openai.com/v1" />
                  <TextBlock Grid.Row="2" Text="API Key" VerticalAlignment="Center" Margin="0,4" />
                  <TextBox x:Name="ChatProfileApiKeyText" Grid.Row="2" Grid.Column="1" Margin="0,4" PasswordChar="•" />
                  <TextBlock Grid.Row="3" Text="模型" VerticalAlignment="Center" Margin="0,4" />
                  <TextBox x:Name="ChatProfileModelText" Grid.Row="3" Grid.Column="1" Margin="0,4"
                           Watermark="如 gpt-4o-mini / deepseek-chat / qwen2.5:7b" />
                  <TextBlock Grid.Row="4" Text="接口格式" VerticalAlignment="Center" Margin="0,4" />
                  <ComboBox x:Name="ChatProfileFormatCombo" Grid.Row="4" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" MinWidth="220">
                    <ComboBoxItem Content="Chat Completions" Tag="OpenAi" />
                    <ComboBoxItem Content="Responses" Tag="Responses" />
                    <ComboBoxItem Content="Messages（Anthropic）" Tag="Anthropic" />
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="翻译提示词" FontSize="16" FontWeight="SemiBold" />
            <TextBox x:Name="TranslationPromptText" AcceptsReturn="True" Height="120" TextWrapping="Wrap"
                     Watermark="留空使用内置默认提示词" FontSize="13" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="恢复默认提示词" Click="ResetPrompt_Click" />
              <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         Text="支持 {}{source} / {}{target} 占位符，只对自定义 API 渠道生效" />
            </StackPanel>

            <TextBlock Text="语言与文档" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="默认目标语言" VerticalAlignment="Center" Margin="0,4" />
              <ComboBox x:Name="SettingsTargetCombo" Grid.Row="0" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" MinWidth="220" />
              <TextBlock Grid.Row="1" Text="文档源语言" VerticalAlignment="Center" Margin="0,4" />
              <ComboBox x:Name="DocumentSourceCombo" Grid.Row="1" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" MinWidth="220" />
              <TextBlock Grid.Row="2" Text="文档目标语言" VerticalAlignment="Center" Margin="0,4" />
              <ComboBox x:Name="DocumentTargetCombo" Grid.Row="2" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" MinWidth="220" />
              <TextBlock Grid.Row="3" Text="文档输出目录" VerticalAlignment="Center" Margin="0,4" />
              <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
                <TextBox x:Name="DocumentOutputDirectoryText" Watermark="留空则输出到原文件目录" />
                <Button Grid.Column="1" Content="选择" Click="BrowseDocumentOutputDirectory_Click" Margin="8,0,0,0" />
              </Grid>
              <TextBlock Grid.Row="4" Text="文档文件后缀" VerticalAlignment="Center" Margin="0,4" />
              <TextBox x:Name="DocumentOutputSuffixText" Grid.Row="4" Grid.Column="1" Margin="0,4" />
              <TextBlock Grid.Row="5" Text="文档并发请求数" VerticalAlignment="Center" Margin="0,4" />
              <TextBox x:Name="DocumentTranslationConcurrencyText" Grid.Row="5" Grid.Column="1" Margin="0,4"
                       Watermark="大于 0 的整数" HorizontalAlignment="Left" MinWidth="220" />
            </Grid>

            <TextBlock Text="全局快捷键" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="输入翻译" VerticalAlignment="Center" Margin="0,3" />
              <TextBox x:Name="InputHotkeyText" Grid.Row="0" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="1" Text="截图" VerticalAlignment="Center" Margin="0,3" />
              <TextBox x:Name="ScreenshotHotkeyText" Grid.Row="1" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="2" Text="截图翻译" VerticalAlignment="Center" Margin="0,3" />
              <TextBox x:Name="ScreenshotTranslateHotkeyText" Grid.Row="2" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="3" Text="静默 OCR" VerticalAlignment="Center" Margin="0,3" />
              <TextBox x:Name="SilentOcrHotkeyText" Grid.Row="3" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="4" Text="截图 OCR" VerticalAlignment="Center" Margin="0,3" />
              <TextBox x:Name="ScreenshotOcrHotkeyText" Grid.Row="4" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="5" Text="剪贴板历史" VerticalAlignment="Center" Margin="0,3" />
              <TextBox x:Name="ClipboardHotkeyText" Grid.Row="5" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="6" Text="贴图" VerticalAlignment="Center" Margin="0,3" />
              <TextBox x:Name="PinnedImageHotkeyText" Grid.Row="6" Grid.Column="1" Margin="0,3" />
            </Grid>
            <TextBlock x:Name="HotkeyStatus" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Classes="accent" Content="保存设置" Click="SaveSettings_Click" />
              <Button Content="测试翻译服务" Click="TestProvider_Click" />
            </StackPanel>
            <TextBlock x:Name="SettingsStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="FooterStatus" Margin="20,0" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}" FontSize="11" Text="就绪" />
    </Border>
  </Grid>
</Window>
