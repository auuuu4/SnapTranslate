<Window x:Class="SnapTranslate.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备注" Width="460" Height="300" MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="备注" Style="{StaticResource PageTitleTextStyle}" />
    <TextBox x:Name="NoteText" Grid.Row="1" Margin="0,16,0,0" AcceptsReturn="True"
             TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="取消" IsCancel="True" MinWidth="76" Margin="0,0,8,0" />
      <Button Content="保存" IsDefault="True" MinWidth="76"
              Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
