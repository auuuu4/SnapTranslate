<Window x:Class="SnapTranslate.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板" Width="680" Height="540" MinWidth="560" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource SurfaceBrush}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="ClipboardListItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="68" />
        <RowDefinition Height="*" />
        <RowDefinition Height="58" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
              <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="剪贴板" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Button Content="×" Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource TextFont}"
                  FontSize="20" HorizontalAlignment="Right" ToolTip="关闭" Click="Close_Click" />
        </Grid>
      </Border>

      <Border x:Name="SearchBarRow" Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="14,13">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="144" />
          </Grid.ColumnDefinitions>
          <Grid Margin="0,0,10,0">
            <TextBox x:Name="SearchText" Style="{StaticResource ClipboardSearchTextBoxStyle}"
                     ToolTip="搜索剪贴板" TextChanged="SearchText_TextChanged"
                     PreviewKeyDown="SearchText_PreviewKeyDown" />
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FaintBrush}"
                       Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          <ComboBox x:Name="FilterCombo" Grid.Column="1" Height="42" SelectionChanged="FilterCombo_SelectionChanged">
            <ComboBoxItem Content="全部类型" Tag="All" IsSelected="True" />
            <ComboBoxItem Content="文本" Tag="Text" />
            <ComboBoxItem Content="图片" Tag="Image" />
            <ComboBoxItem Content="文件" Tag="Files" />
            <ComboBoxItem Content="收藏" Tag="Favorite" />
          </ComboBox>
        </Grid>
      </Border>

      <ListBox x:Name="ItemsList" Grid.Row="2" Margin="14,12,14,4" BorderThickness="0"
               Background="Transparent" ItemContainerStyle="{StaticResource ClipboardListItemStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="ItemsList_MouseDoubleClick" SelectionChanged="ItemsList_SelectionChanged"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border x:Name="ItemSurface" Height="96" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
              <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <Border Width="62" Height="62" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6"
                        VerticalAlignment="Center" ClipToBounds="True">
                  <Grid>
                    <Image x:Name="QuickThumbnail"
                           Source="{Binding ImagePath, Converter={StaticResource ClipboardThumbnailConverter}}"
                           Stretch="UniformToFill" />
                    <TextBlock x:Name="QuickKindFallback" Text="{Binding KindLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                  </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="5,0,12,0" VerticalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Button Style="{StaticResource NoteAreaButtonStyle}"
                          Content="{Binding NoteDisplay}"
                          ToolTip="{Binding NoteActionText}"
                          AutomationProperties.Name="{Binding NoteActionText}"
                          Click="InlineNote_Click" />
                  <TextBlock Grid.Row="1" Text="{Binding PreviewText}" TextWrapping="Wrap" MaxHeight="38" Margin="1,5,0,0"
                             Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <Button Style="{StaticResource FavoriteIconButtonStyle}"
                          Content="{Binding FavoriteDisplay}"
                          ToolTip="{Binding FavoriteActionText}"
                          AutomationProperties.Name="{Binding FavoriteActionText}"
                          Click="InlineFavorite_Click" />
                  <TextBlock Text="{Binding CreatedDisplay}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                             HorizontalAlignment="Right" Margin="0,2,1,0" />
                </StackPanel>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsImage}" Value="True">
                <Setter TargetName="QuickKindFallback" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="3" Background="{StaticResource SurfaceMutedBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="12,0">
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                     Foreground="{StaticResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="FavoriteButton" Content="收藏" ToolTip="收藏当前条目"
                    MinWidth="62" Margin="0,0,3,0" Click="Favorite_Click" />
            <Button x:Name="NoteButton" Content="备注" ToolTip="编辑备注"
                    MinWidth="56" Margin="0,0,3,0" Click="Note_Click" />
            <Button x:Name="OcrButton" Content="OCR" ToolTip="识别图片文字" Margin="0,0,3,0" Click="Ocr_Click" />
            <Button x:Name="DeleteButton" Content="删除" ToolTip="删除当前条目"
                    MinWidth="56" Margin="0,0,8,0" Click="Delete_Click" />
            <Button Content="纯文本" Margin="0,0,8,0" Click="PastePlain_Click" />
            <Button Content="粘贴" Style="{StaticResource PrimaryButtonStyle}" MinWidth="76" Click="Paste_Click" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
