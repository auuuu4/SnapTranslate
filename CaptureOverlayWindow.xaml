<Window x:Class="SnapTranslate.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True" Cursor="Cross"
        Background="Black" KeyDown="Window_KeyDown">
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Foreground" Value="#F4F7F6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#34433E" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style x:Key="HandleStyle" TargetType="Thumb">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ColorSwatchButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderBrush" Value="#80FFFFFF" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Ellipse x:Name="Swatch" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="1.5" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="StrokeThickness" Value="2.5" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.65" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid"
        PreviewMouseLeftButtonDown="Surface_MouseLeftButtonDown"
        MouseMove="Surface_MouseMove"
        MouseLeftButtonUp="Surface_MouseLeftButtonUp"
        MouseRightButtonDown="Surface_MouseRightButtonDown">
    <Image x:Name="ScreenImage" Stretch="Fill" SnapsToDevicePixels="True" />
    <Canvas x:Name="SelectionCanvas" Background="Transparent">
      <Rectangle x:Name="ShadeTop" Fill="#900B1210" IsHitTestVisible="False" />
      <Rectangle x:Name="ShadeLeft" Fill="#900B1210" IsHitTestVisible="False" />
      <Rectangle x:Name="ShadeRight" Fill="#900B1210" IsHitTestVisible="False" />
      <Rectangle x:Name="ShadeBottom" Fill="#900B1210" IsHitTestVisible="False" />
      <Border x:Name="SmartBorder" Visibility="Collapsed" IsHitTestVisible="False"
              BorderBrush="#9FE1CF" BorderThickness="2" Background="#0811856B" />
      <Canvas x:Name="AnnotationCanvas" Background="Transparent" />
      <Border x:Name="SelectionBorder" Visibility="Collapsed" IsHitTestVisible="False"
              BorderBrush="White" BorderThickness="1" Background="Transparent">
        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.8" /></Border.Effect>
      </Border>

      <Thumb x:Name="HandleNW" Tag="NorthWest" Style="{StaticResource HandleStyle}" Cursor="SizeNWSE" />
      <Thumb x:Name="HandleN" Tag="North" Style="{StaticResource HandleStyle}" Cursor="SizeNS" />
      <Thumb x:Name="HandleNE" Tag="NorthEast" Style="{StaticResource HandleStyle}" Cursor="SizeNESW" />
      <Thumb x:Name="HandleE" Tag="East" Style="{StaticResource HandleStyle}" Cursor="SizeWE" />
      <Thumb x:Name="HandleSE" Tag="SouthEast" Style="{StaticResource HandleStyle}" Cursor="SizeNWSE" />
      <Thumb x:Name="HandleS" Tag="South" Style="{StaticResource HandleStyle}" Cursor="SizeNS" />
      <Thumb x:Name="HandleSW" Tag="SouthWest" Style="{StaticResource HandleStyle}" Cursor="SizeNESW" />
      <Thumb x:Name="HandleW" Tag="West" Style="{StaticResource HandleStyle}" Cursor="SizeWE" />

      <Border x:Name="SizeBadge" Visibility="Collapsed" IsHitTestVisible="False"
              Background="#F018211F" CornerRadius="5" Padding="8,4">
        <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
      </Border>
      <Border x:Name="Magnifier" Visibility="Collapsed" IsHitTestVisible="False"
              Width="134" Background="#F518211F" BorderBrush="#5C6C65" BorderThickness="1"
              CornerRadius="7" Padding="6">
        <StackPanel>
          <Border Width="120" Height="90" BorderBrush="#9099A4" BorderThickness="1">
            <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
          </Border>
          <TextBlock x:Name="PixelInfo" Margin="1,4,1,0" Foreground="#E7EAED"
                     FontFamily="Consolas" FontSize="11" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <TextBox x:Name="TextEditor" Visibility="Collapsed" MinWidth="140" MinHeight="34"
               AcceptsReturn="True" TextWrapping="Wrap" Padding="6"
               Background="#F7FFFFFF" Foreground="#1E2328" BorderBrush="{StaticResource AccentBrush}"
               BorderThickness="2" FontSize="18" KeyDown="TextEditor_KeyDown"
               LostKeyboardFocus="TextEditor_LostKeyboardFocus" />

      <Border x:Name="Toolbar" Visibility="Collapsed" Background="#F518211F"
              BorderBrush="#465750" BorderThickness="1" CornerRadius="8" Padding="6">
        <StackPanel Orientation="Horizontal">
          <ContentControl x:Name="ToolOptionsInlineSlot">
            <StackPanel x:Name="EditingToolsGroup" Orientation="Horizontal">
              <Button x:Name="SelectToolButton" Style="{StaticResource ToolButton}" Content="↖" FontFamily="Segoe UI Symbol" ToolTip="选择与移动" Click="ToolButton_Click" Tag="Select" />
              <Button x:Name="RectangleToolButton" Style="{StaticResource ToolButton}" Content="□" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="矩形" Click="ToolButton_Click" Tag="Rectangle" />
              <Button x:Name="EllipseToolButton" Style="{StaticResource ToolButton}" Content="○" FontFamily="Segoe UI" FontSize="19" ToolTip="椭圆" Click="ToolButton_Click" Tag="Ellipse" />
              <Button x:Name="ArrowToolButton" Style="{StaticResource ToolButton}" Content="→" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="箭头" Click="ToolButton_Click" Tag="Arrow" />
              <Button x:Name="PenToolButton" Style="{StaticResource ToolButton}" Content="✎" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="画笔" Click="ToolButton_Click" Tag="Pen" />
              <Button x:Name="TextToolButton" Style="{StaticResource ToolButton}" Content="T" FontFamily="Segoe UI" FontWeight="SemiBold" ToolTip="文字" Click="ToolButton_Click" Tag="Text" />
              <Button x:Name="MosaicToolButton" Style="{StaticResource ToolButton}" Content="▦" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="马赛克" Click="ToolButton_Click" Tag="Mosaic" />
              <Rectangle Width="1" Height="22" Margin="5,0" Fill="#465750" />
              <Button Style="{StaticResource ColorSwatchButton}" Tag="#E53935" Background="#E53935" ToolTip="红色" Click="ColorButton_Click" />
              <Button Style="{StaticResource ColorSwatchButton}" Tag="#F5B400" Background="#F5B400" ToolTip="黄色" Click="ColorButton_Click" />
              <Button Style="{StaticResource ColorSwatchButton}" Tag="#18A572" Background="#18A572" ToolTip="绿色" Click="ColorButton_Click" />
              <Button Style="{StaticResource ColorSwatchButton}" Tag="#2389DA" Background="#2389DA" ToolTip="蓝色" Click="ColorButton_Click" />
              <Button Style="{StaticResource ColorSwatchButton}" Tag="#FFFFFF" Background="#FFFFFF" BorderBrush="#8095A29C" ToolTip="白色" Click="ColorButton_Click" />
              <Slider x:Name="LineWidthSlider" Width="56" Minimum="2" Maximum="12" Value="4"
                      Margin="5,0" VerticalAlignment="Center" ToolTip="线条粗细" />
              <Rectangle Width="1" Height="22" Margin="5,0" Fill="#465750" />
              <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Content="↶" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="撤销 (Ctrl+Z)" Click="Undo_Click" />
              <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Content="↷" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="重做 (Ctrl+Y)" Click="Redo_Click" />
              <Button Style="{StaticResource ToolButton}" Content="保存" FontFamily="Microsoft YaHei UI" FontSize="10" ToolTip="保存图片" Click="Save_Click" />
              <Button Style="{StaticResource ToolButton}" Content="贴图" FontFamily="Microsoft YaHei UI" FontSize="10" ToolTip="贴到屏幕" Click="Pin_Click" />
              <Rectangle Width="1" Height="22" Margin="5,0" Fill="#465750" />
            </StackPanel>
          </ContentControl>
          <Button Style="{StaticResource ToolButton}" Content="复制" FontFamily="Microsoft YaHei UI" FontSize="10" ToolTip="复制图片" Click="Copy_Click" />
          <Button Style="{StaticResource ToolButton}" Content="OCR" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" ToolTip="文字识别" Click="Ocr_Click" />
          <Button Style="{StaticResource ToolButton}" Content="译" FontFamily="Microsoft YaHei UI" FontSize="14" ToolTip="识别并翻译" Click="Translate_Click" />
          <Button Style="{StaticResource ToolButton}" Content="×" FontFamily="{StaticResource TextFont}" FontSize="18" ToolTip="取消 (Esc)" Click="Cancel_Click" />
          <Button x:Name="CompleteButton" Style="{StaticResource PrimaryButton}" Content="✓" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="完成 (Enter)" Click="Complete_Click" />
        </StackPanel>
      </Border>

      <Border x:Name="CompactToolbar" Visibility="Collapsed" Background="#F518211F"
              BorderBrush="#465750" BorderThickness="1" CornerRadius="8" Padding="6">
        <StackPanel>
          <!-- 标注工具直接展开在这块，不用 Popup：弹出的窗口会把点击漏给遮罩层，导致选区被重置 -->
          <Border x:Name="CompactToolsPanel" Visibility="Collapsed" Margin="0,0,0,4">
            <ContentControl x:Name="ToolOptionsCompactSlot" />
          </Border>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="MoreToolsButton" Style="{StaticResource ToolButton}"
                    Content="•••" FontFamily="Segoe UI" FontSize="14" ToolTip="更多标注工具"
                    Click="MoreTools_Click" />
            <Button Style="{StaticResource ToolButton}" Content="复制" FontFamily="Microsoft YaHei UI" FontSize="10" ToolTip="复制图片" Click="Copy_Click" />
            <Button Style="{StaticResource ToolButton}" Content="OCR" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" ToolTip="文字识别" Click="Ocr_Click" />
            <Button Style="{StaticResource ToolButton}" Content="译" FontFamily="Microsoft YaHei UI" FontSize="14" ToolTip="识别并翻译" Click="Translate_Click" />
            <Button Style="{StaticResource ToolButton}" Content="×" FontFamily="{StaticResource TextFont}" FontSize="18" ToolTip="取消 (Esc)" Click="Cancel_Click" />
            <Button x:Name="CompactCompleteButton" Style="{StaticResource PrimaryButton}" Content="✓" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="完成 (Enter)" Click="Complete_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</Window>
