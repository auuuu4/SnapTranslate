<Window x:Class="SnapTranslate.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" Topmost="True" Background="Transparent"
        AllowsTransparency="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp" MouseMove="Window_MouseMove"
        MouseWheel="Window_MouseWheel" MouseDoubleClick="Window_MouseDoubleClick"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True">
  <Border x:Name="PinFrame" Margin="8" BorderThickness="1.5" Background="#18211F" CornerRadius="6" Padding="2">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59D6B5" Offset="0" />
        <GradientStop Color="#11856B" Offset="0.48" />
        <GradientStop Color="#4E7FD1" Offset="1" />
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Effect>
      <DropShadowEffect Color="#11856B" BlurRadius="16" ShadowDepth="0" Opacity="0.48" />
    </Border.Effect>
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="&#x590D;&#x5236;&#x56FE;&#x7247;" Click="Copy_Click" />
        <MenuItem Header="&#x4FDD;&#x5B58;&#x56FE;&#x7247;..." Click="Save_Click" />
        <Separator />
        <MenuItem x:Name="TopmostMenuItem" Header="&#x603B;&#x5728;&#x6700;&#x524D;"
                  IsCheckable="True" IsChecked="True" Click="Topmost_Click" />
        <MenuItem Header="&#x5173;&#x95ED;&#x8D34;&#x56FE;" Click="Close_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <Image x:Name="PinnedImage" Stretch="Fill" SnapsToDevicePixels="True"
           RenderOptions.BitmapScalingMode="HighQuality">
      <Image.Clip>
        <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,100000,100000" />
      </Image.Clip>
    </Image>
  </Border>
</Window>
