                  <Button Grid.Column="1" Content="×" Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource TextFont}" FontSize="18" ToolTip="清除"
                          HorizontalAlignment="Right" Tag="ClipboardHotkeyText" Click="ClearHotkey_Click" />
                </Grid>
                <TextBlock Grid.Row="6" Text="&#x8D34;&#x56FE;" Style="{StaticResource FieldLabelStyle}" />
                <Grid Grid.Row="6" Grid.Column="1" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="PinnedImageHotkeyText" IsReadOnly="True" PreviewKeyDown="HotkeyText_PreviewKeyDown" />
                  <Button Grid.Column="1" Content="&#x00D7;" Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource TextFont}" FontSize="18" ToolTip="&#x6E05;&#x9664;"
                          HorizontalAlignment="Right" Tag="PinnedImageHotkeyText" Click="ClearHotkey_Click" />
                </Grid>
                <TextBlock Grid.Row="7" Text="&#x8D34;&#x56FE;&#x8FB9;&#x7F18;" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox x:Name="PinnedImageEdgeEffectCombo" Grid.Row="7" Grid.Column="1" Margin="0,4">
                  <ComboBoxItem Content="&#x6E10;&#x53D8;&#x9AD8;&#x4EAE;" Tag="Gradient" />
                  <ComboBoxItem Content="&#x4E0D;&#x9AD8;&#x4EAE;" Tag="None" />
                </ComboBox>
                <TextBlock Grid.Row="8" Text="静默 OCR 行为" Style="{StaticResource FieldLabelStyle}" />
