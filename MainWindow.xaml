              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="翻译语言" Style="{StaticResource FieldLabelStyle}" />
                <Grid Grid.Column="1" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <ComboBox x:Name="DocumentSourceLanguageCombo">
                    <ComboBoxItem Content="自动检测" Tag="auto" />
                    <ComboBoxItem Content="简体中文" Tag="zh" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                    <ComboBoxItem Content="한국어" Tag="ko" />
                    <ComboBoxItem Content="Français" Tag="fr" />
                    <ComboBoxItem Content="Deutsch" Tag="de" />
                    <ComboBoxItem Content="Español" Tag="es" />
                    <ComboBoxItem Content="Русский" Tag="ru" />
                  </ComboBox>
                  <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FaintBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <ComboBox x:Name="DocumentTargetLanguageCombo" Grid.Column="2">
                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                    <ComboBoxItem Content="한국어" Tag="ko" />
                    <ComboBoxItem Content="Français" Tag="fr" />
                    <ComboBoxItem Content="Deutsch" Tag="de" />
                    <ComboBoxItem Content="Español" Tag="es" />
                    <ComboBoxItem Content="Русский" Tag="ru" />
                  </ComboBox>
                </Grid>
                <TextBlock Grid.Row="1" Text="输出目录" Style="{StaticResource FieldLabelStyle}" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="DocumentOutputDirectoryText" />
