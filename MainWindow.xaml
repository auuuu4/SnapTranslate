                  <TextBox x:Name="DocumentOutputSuffixText" Grid.Column="1" />
                  <TextBlock Grid.Column="2" Text="并发请求数" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <TextBox x:Name="DocumentTranslationConcurrencyText" Grid.Column="3"
