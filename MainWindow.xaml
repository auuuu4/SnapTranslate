                <DataGridTextColumn Header="原文" Binding="{Binding Source}" Width="2*" />
                <DataGridTextColumn Header="译文" Binding="{Binding Translation}" Width="2*" />
                <DataGridTextColumn Header="来源" Binding="{Binding Provider}" Width="190" />
