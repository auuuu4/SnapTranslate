                    <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,2,0,6" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="每条渠道独立保存名称、地址、密钥和模型；「设为当前」决定用哪一条翻译。三种格式覆盖 OpenAI、DeepSeek、通义、Anthropic，以及本地 vLLM / LM Studio / Ollama 等。" />
                  </Grid>
                </StackPanel>

                <StackPanel x:Name="AutoChainPanel" Grid.Row="4" Grid.ColumnSpan="2" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="自动顺序" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,11,18,7" />
                    <StackPanel Grid.Column="1" Margin="0,4,0,0">
                      <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox x:Name="AutoChainList" BorderThickness="0" Background="Transparent"
                                 MinHeight="128" MaxHeight="200" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="上移" MinHeight="0" Margin="0,0,6,0" Style="{StaticResource SubtleButtonStyle}"
                                Click="MoveAutoChainUp_Click" />
                        <Button Content="下移" MinHeight="0" Margin="0,0,6,0" Style="{StaticResource SubtleButtonStyle}"
                                Click="MoveAutoChainDown_Click" />
                        <Button Content="移除" MinHeight="0" Margin="0,0,18,0" Style="{StaticResource SubtleButtonStyle}"
                                Click="RemoveAutoChain_Click" />
                        <ComboBox x:Name="AutoChainAddCombo" MinWidth="150" Style="{StaticResource SettingsComboStyle}" />
                        <Button Content="添加" MinHeight="0" Margin="6,0,0,0" Style="{StaticResource SubtleButtonStyle}"
                                Click="AddAutoChain_Click" />
                        <Button Content="恢复默认" MinHeight="0" Margin="18,0,0,0" Style="{StaticResource SubtleButtonStyle}"
                                Click="ResetAutoChain_Click" />
                      </StackPanel>
                      <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,4" TextWrapping="Wrap"
                                 Text="按从上到下的顺序尝试；没配置好的通道（缺模型、缺接口地址）会自动跳过。只影响「自动」模式。" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>

              <TextBlock Text="翻译提示词" Style="{StaticResource SectionTitleTextStyle}" Margin="0,28,0,6" />
              <Separator />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="提示词" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,11,18,7" />
                <StackPanel Grid.Column="1" Margin="0,4,0,0">
                  <TextBox x:Name="TranslationPromptText" Height="136" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" Padding="11,9"
                           VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           ToolTip="只有「自定义 API」通道会读取这段提示词；内置免费的通道不读。" />
                  <Grid Margin="0,8,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="恢复默认提示词" MinHeight="0" Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Top" Click="ResetTranslationPrompt_Click" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Margin="12,2,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{}{source} / {target} 会替换成语言名；只有「自定义 API」通道会读取这段提示词，内置免费通道不使用。" />
                  </Grid>
                </StackPanel>
              </Grid>

              <TextBlock Text="快捷键" Style="{StaticResource SectionTitleTextStyle}" Margin="0,28,0,6" />
              <Separator />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="输入翻译" Style="{StaticResource FieldLabelStyle}" />
                <Grid Grid.Column="1" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="InputHotkeyText" IsReadOnly="True" PreviewKeyDown="HotkeyText_PreviewKeyDown" />
                  <Button Grid.Column="1" Content="×" Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource TextFont}" FontSize="18" ToolTip="清除"
                          HorizontalAlignment="Right" Tag="InputHotkeyText" Click="ClearHotkey_Click" />
                </Grid>
                <TextBlock Grid.Row="1" Text="截图" Style="{StaticResource FieldLabelStyle}" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="ScreenshotHotkeyText" IsReadOnly="True" PreviewKeyDown="HotkeyText_PreviewKeyDown" />
                  <Button Grid.Column="1" Content="×" Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource TextFont}" FontSize="18" ToolTip="清除"
                          HorizontalAlignment="Right" Tag="ScreenshotHotkeyText" Click="ClearHotkey_Click" />
                </Grid>
                <TextBlock Grid.Row="2" Text="截图翻译" Style="{StaticResource FieldLabelStyle}" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="ScreenshotTranslateHotkeyText" IsReadOnly="True" PreviewKeyDown="HotkeyText_PreviewKeyDown" />
                  <Button Grid.Column="1" Content="×" Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource TextFont}" FontSize="18" ToolTip="清除"
                          HorizontalAlignment="Right" Tag="ScreenshotTranslateHotkeyText" Click="ClearHotkey_Click" />
                </Grid>
                <TextBlock Grid.Row="3" Text="静默 OCR" Style="{StaticResource FieldLabelStyle}" />
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="SilentOcrHotkeyText" IsReadOnly="True" PreviewKeyDown="HotkeyText_PreviewKeyDown" />
                  <Button Grid.Column="1" Content="×" Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource TextFont}" FontSize="18" ToolTip="清除"
                          HorizontalAlignment="Right" Tag="SilentOcrHotkeyText" Click="ClearHotkey_Click" />
