                    <TextBlock Grid.Row="4" Text="API Key" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ChatApiKeyText" Grid.Row="4" Grid.Column="1" Style="{StaticResource SettingsFieldStyle}"
                             TextChanged="ChatProfileField_Changed"
                             ToolTip="保存在本机 settings.json 中，不会上传到别处；本地模型服务可以留空。" />

                    <TextBlock Grid.Row="5" Text="模型" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBox x:Name="ChatApiModelText" Style="{StaticResource SettingsFieldStyle}"
                               TextChanged="ChatProfileField_Changed"
                               ToolTip="模型名，例如 gpt-4o-mini、deepseek-chat、claude-3-5-sonnet-latest" />
