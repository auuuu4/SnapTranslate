                  <TextBox x:Name="ClipboardMaxItemsText" Grid.Column="1" />
                  <TextBlock Grid.Column="2" Text="保留天数" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <TextBox x:Name="ClipboardRetentionDaysText" Grid.Column="3" />
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="StartupCheck" Content="开机启动" Margin="0,0,24,0" />
                    <CheckBox x:Name="CloseToTrayCheck" Content="关闭窗口时留在托盘" />
                  </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" Text="窗口" Style="{StaticResource FieldLabelStyle}" />
                <CheckBox x:Name="KeepOnTopCheck" Grid.Row="2" Grid.Column="1" Margin="0,9,0,8"
                          Content="主窗口始终置顶（截屏时会自动隐藏）"
                          Checked="KeepOnTopCheck_Changed" Unchecked="KeepOnTopCheck_Changed" />
              </Grid>

              <TextBlock Text="文档翻译" Style="{StaticResource SectionTitleTextStyle}" Margin="0,28,0,6" />
