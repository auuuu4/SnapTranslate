                          HorizontalAlignment="Right" Tag="ScreenshotOcrHotkeyText" Click="ClearHotkey_Click" />
                </Grid>
                <TextBlock Grid.Row="5" Text="剪贴板" Style="{StaticResource FieldLabelStyle}" />
