                           PreviewTextInput="PositiveIntegerText_PreviewTextInput"
                           DataObject.Pasting="PositiveIntegerText_Pasting" />
                </Grid>
              </Grid>

              <TextBlock Text="通知" Style="{StaticResource SectionTitleTextStyle}" Margin="0,28,0,6" />
              <Separator />
              <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="通知弹窗" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox x:Name="NotifyScreenshotActionsCheck" Content="截图完成" Margin="0,0,24,0" />
                  <CheckBox x:Name="NotifyOcrResultsCheck" Content="OCR 完成" Margin="0,0,24,0" />
                  <CheckBox x:Name="NotifyErrorsCheck" Content="错误提示" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>

