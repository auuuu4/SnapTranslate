                  <CheckBox x:Name="ClipboardAutoPasteCheck" Content="双击条目自动粘贴" Margin="0,4" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="存储与启动" Style="{StaticResource FieldLabelStyle}" />
