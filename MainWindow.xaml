<Window x:Class="SnapTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SnapTranslate" Width="1080" Height="760" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceBrush}"
        WindowStyle="None" ResizeMode="CanResize" Icon="Assets/AppIcon.ico"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing" Closed="Window_Closed" AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter" PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave" Drop="Window_Drop">
  <Window.Resources>
    <Style x:Key="PageDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
      <Setter Property="Margin" Value="0,5,0,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,7,18,7" />
    </Style>
    <Style x:Key="SettingsFieldStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style x:Key="SettingsComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style x:Key="PaneHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextStyle}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="ButtonSurface"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#E9EFED" Duration="0:0:0.14" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="ButtonSurface"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#00FFFFFF" Duration="0:0:0.10" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="68" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{StaticResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="7" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
            <Image Source="Assets/AppIcon.png" Stretch="UniformToFill" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SnapTranslate" FontFamily="{StaticResource DisplayFont}"
                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="最小化" Click="Minimize_Click">
            <Path Data="M 2,8 L 12,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.25" SnapsToDevicePixels="True" />
          </Button>
          <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="最大化" Click="ToggleMaximize_Click">
            <Grid Width="14" Height="14">
              <Path x:Name="MaximizeGlyph" Data="M 1.5,1.5 L 12.5,1.5 L 12.5,12.5 L 1.5,12.5 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.2" />
              <Path x:Name="RestoreGlyph" Visibility="Collapsed"
                    Data="M 4.5,1.5 L 12.5,1.5 L 12.5,9.5 M 1.5,4.5 L 9.5,4.5 L 9.5,12.5 L 1.5,12.5 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.2" />
            </Grid>
          </Button>
          <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="关闭" Click="CloseWindow_Click">
            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.3" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource MainTabControlStyle}" SelectedIndex="0">
      <TabItem Header="文本翻译" Tag="&#xE70F;">
        <Grid Margin="28,24,28,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="文本翻译" Style="{StaticResource PageTitleTextStyle}" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,22,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="142" />
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="142" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="语言" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
            <ComboBox x:Name="QuickSourceCombo" Grid.Column="1"
                      SelectionChanged="QuickSourceCombo_SelectionChanged">
              <ComboBoxItem Content="自动检测" Tag="auto" IsSelected="True" />
              <ComboBoxItem Content="简体中文" Tag="zh" />
              <ComboBoxItem Content="English" Tag="en" />
              <ComboBoxItem Content="日本語" Tag="ja" />
              <ComboBoxItem Content="한국어" Tag="ko" />
              <ComboBoxItem Content="Français" Tag="fr" />
              <ComboBoxItem Content="Deutsch" Tag="de" />
              <ComboBoxItem Content="Español" Tag="es" />
              <ComboBoxItem Content="Русский" Tag="ru" />
            </ComboBox>
            <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ComboBox x:Name="QuickTargetCombo" Grid.Column="3"
                      SelectionChanged="QuickTargetCombo_SelectionChanged">
              <ComboBoxItem Content="自动" Tag="auto" IsSelected="True" />
              <ComboBoxItem Content="简体中文" Tag="zh-CN" />
              <ComboBoxItem Content="English" Tag="en" />
              <ComboBoxItem Content="日本語" Tag="ja" />
              <ComboBoxItem Content="한국어" Tag="ko" />
              <ComboBoxItem Content="Français" Tag="fr" />
              <ComboBoxItem Content="Deutsch" Tag="de" />
              <ComboBoxItem Content="Español" Tag="es" />
              <ComboBoxItem Content="Русский" Tag="ru" />
            </ComboBox>
            <Button x:Name="TranslateInputButton" Grid.Column="5" Content="翻译"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="94" Margin="12,0,0,0"
                    Click="TranslateInput_Click" />
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="46" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                        Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8,8,0,0">
                  <Grid Margin="14,0">
                    <TextBlock Text="原文" Style="{StaticResource PaneHeaderStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button x:Name="CopyInputButton" Content="复制原文" Style="{StaticResource SubtleButtonStyle}" Padding="9,4"
                              Margin="0,0,8,0" ToolTip="复制原文" Click="CopyInput_Click" />
                      <Button Content="清空" Style="{StaticResource SubtleButtonStyle}" Padding="9,4"
                              ToolTip="清空原文和译文" Click="ClearInput_Click" />
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBox x:Name="InputText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Style="{StaticResource BorderlessTextBoxStyle}" Padding="16,14" FontSize="15"
                         PreviewKeyDown="InputText_PreviewKeyDown" />
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="46" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                        Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8,8,0,0">
                  <Grid Margin="14,0">
                    <TextBlock Text="译文" Style="{StaticResource PaneHeaderStyle}" />
                    <Button x:Name="CopyResultButton" Content="复制译文" Style="{StaticResource SubtleButtonStyle}" Padding="9,4"
                            HorizontalAlignment="Right" ToolTip="复制翻译结果" Click="CopyInputResult_Click" />
                  </Grid>
                </Border>
                <TextBox x:Name="InputResultText" Grid.Row="1" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Style="{StaticResource BorderlessTextBoxStyle}" Padding="16,14" FontSize="15" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="截图工具" Tag="&#xE7C4;">
        <Grid Margin="28,24,28,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="截图工具" Style="{StaticResource PageTitleTextStyle}" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource ToolCardButtonStyle}"
                    Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentLineBrush}"
                    Click="ScreenshotTranslate_Click">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="7" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                  <TextBlock Text="译" Foreground="White" FontSize="17" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="截图翻译" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource ToolCardButtonStyle}" Click="ScreenshotOcr_Click">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="7" Background="#EAF0FC" VerticalAlignment="Center">
                  <TextBlock Text="OCR" Foreground="{StaticResource InfoBrush}" FontSize="11" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="截图 OCR" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource ToolCardButtonStyle}" Click="SilentOcr_Click">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="7" Background="#FFF3E3" VerticalAlignment="Center">
                  <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WarningBrush}"
                             FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="静默 OCR" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </Button>
          </Grid>

        </Grid>
      </TabItem>

      <TabItem Header="任务中心" Tag="&#xE9D5;">
        <Grid Margin="28,24,28,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="任务中心" Style="{StaticResource PageTitleTextStyle}" />
              <TextBlock x:Name="DocumentTaskCountText" Style="{StaticResource PageDescriptionStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="清除已完成" Margin="0,0,8,0" Click="ClearCompletedDocumentTasks_Click" />
              <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddDocumentFiles_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,7,0" />
                  <TextBlock Text="添加文件" Foreground="White" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="搜索" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}" />
            <TextBox x:Name="DocumentTaskSearchText" Grid.Column="1" ToolTip="按文件名、绝对路径或状态搜索"
                     TextChanged="DocumentTaskSearchText_TextChanged"
                     PreviewKeyDown="SearchText_PreviewKeyDown" />
          </Grid>
          <TextBlock Grid.Row="2" Text="文档翻译" Style="{StaticResource SectionTitleTextStyle}" Margin="0,18,0,10" />
          <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid x:Name="DocumentTaskGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="72">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="文件与绝对路径" Width="2*" MinWidth="260">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="4,5" ToolTip="{Binding SourcePath}">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SourcePath}" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="类型" Binding="{Binding Format}" Width="64" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="78" />
                <DataGridTemplateColumn Header="进度" Width="156">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Margin="5,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding ProgressDisplay}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Right" Margin="0,0,0,4" />
                        <ProgressBar Grid.Row="1" Value="{Binding Progress}" Minimum="0" Maximum="100" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="详情 / 输出路径" Width="*" MinWidth="180">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="4,5">
                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding OutputPath}" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding OutputPath}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="116">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="定位" ToolTip="打开输出位置" Padding="8,4" Margin="0,0,4,0"
                                Width="52" Height="32" IsEnabled="{Binding CanOpen}" Click="OpenDocumentOutput_Click" />
                        <Button Content="取消" ToolTip="取消任务" Padding="8,4"
                                Width="52" Height="32" IsEnabled="{Binding CanCancel}" Click="CancelDocumentTask_Click" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="剪贴板" Tag="&#xE8C8;">
        <Grid Margin="28,24,28,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="剪贴板" Style="{StaticResource PageTitleTextStyle}" />
              <TextBlock x:Name="ClipboardCountText" Style="{StaticResource PageDescriptionStyle}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="0,22,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="148" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,10,0">
              <TextBox x:Name="ClipboardSearchText" Style="{StaticResource ClipboardSearchTextBoxStyle}"
                       ToolTip="搜索剪贴板" TextChanged="ClipboardSearchText_TextChanged"
                       PreviewKeyDown="SearchText_PreviewKeyDown" />
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FaintBrush}"
                         Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <ComboBox x:Name="ClipboardFilterCombo" Grid.Column="1"
                      SelectionChanged="ClipboardFilterCombo_SelectionChanged">
              <ComboBoxItem Content="全部类型" Tag="All" IsSelected="True" />
              <ComboBoxItem Content="文本" Tag="Text" />
              <ComboBoxItem Content="图片" Tag="Image" />
              <ComboBoxItem Content="文件" Tag="Files" />
              <ComboBoxItem Content="收藏" Tag="Favorite" />
            </ComboBox>
          </Grid>
          <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid x:Name="ClipboardGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="68"
                      MouseDoubleClick="ClipboardGrid_MouseDoubleClick"
                      SelectionChanged="ClipboardGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="类型" Binding="{Binding KindLabel}" Width="72" />
                <DataGridTemplateColumn Header="预览" Width="72">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Width="52" Height="44" Background="{StaticResource SurfaceMutedBrush}"
                              BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                              CornerRadius="5" ClipToBounds="True">
                        <Grid>
                          <Image x:Name="ClipboardThumbnail"
                                 Source="{Binding ImagePath, Converter={StaticResource ClipboardThumbnailConverter}}"
                                 Stretch="UniformToFill" Visibility="Collapsed"
                                 RenderOptions.BitmapScalingMode="HighQuality" />
                          <TextBlock x:Name="ClipboardTypeFallback" Text="{Binding KindLabel}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                          <Setter TargetName="ClipboardThumbnail" Property="Visibility" Value="Visible" />
                          <Setter TargetName="ClipboardTypeFallback" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="内容" Binding="{Binding PreviewText}" Width="*" MinWidth="260" />
                <DataGridTemplateColumn Header="备注" Width="180">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource NoteAreaButtonStyle}"
                              Content="{Binding NoteDisplay}"
                              ToolTip="{Binding NoteActionText}"
                              AutomationProperties.Name="{Binding NoteActionText}"
                              Click="ClipboardInlineNote_Click" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="收藏" Width="68">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource FavoriteIconButtonStyle}"
                              Content="{Binding FavoriteDisplay}"
                              ToolTip="{Binding FavoriteActionText}"
                              AutomationProperties.Name="{Binding FavoriteActionText}"
                              Click="ClipboardFavoriteInline_Click" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedDisplay}" Width="108" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ClipboardFavoriteButton" Content="收藏" ToolTip="收藏当前条目" Margin="0,0,4,0"
                      MinWidth="64" Click="ClipboardFavorite_Click" />
              <Button Content="备注" ToolTip="编辑备注" Margin="0,0,4,0" MinWidth="58"
                      Click="ClipboardNote_Click" />
              <Button Content="OCR" ToolTip="识别图片文字" Margin="0,0,4,0" Click="ClipboardOcr_Click" />
              <Button Content="删除" ToolTip="删除当前条目" MinWidth="58" Click="ClipboardDelete_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="复制" Margin="0,0,8,0" Click="ClipboardCopy_Click" />
              <Button Content="纯文本粘贴" Margin="0,0,8,0" Click="ClipboardPastePlain_Click" />
              <Button Content="粘贴" Style="{StaticResource PrimaryButtonStyle}" MinWidth="82"
                      Click="ClipboardPaste_Click" />
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="翻译历史" Tag="&#xE81C;">
        <Grid Margin="28,24,28,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="翻译历史" Style="{StaticResource PageTitleTextStyle}" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="搜索" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}" />
            <TextBox x:Name="HistorySearchText" Grid.Column="1" ToolTip="搜索原文、译文或翻译来源"
                     TextChanged="HistorySearchText_TextChanged"
                     PreviewKeyDown="SearchText_PreviewKeyDown" />
          </Grid>
