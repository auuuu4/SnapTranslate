                    <ComboBoxItem Content="自动检测" Tag="auto" />
                    <ComboBoxItem Content="简体中文" Tag="zh" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                    <ComboBoxItem Content="한국어" Tag="ko" />
                    <ComboBoxItem Content="Français" Tag="fr" />
                    <ComboBoxItem Content="Deutsch" Tag="de" />
                    <ComboBoxItem Content="Español" Tag="es" />
                    <ComboBoxItem Content="Русский" Tag="ru" />
                  </ComboBox>
                  <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FaintBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <ComboBox x:Name="SettingsTargetCombo" Grid.Column="2">
                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                    <ComboBoxItem Content="한국어" Tag="ko" />
                    <ComboBoxItem Content="Français" Tag="fr" />
                    <ComboBoxItem Content="Deutsch" Tag="de" />
                    <ComboBoxItem Content="Español" Tag="es" />
                    <ComboBoxItem Content="Русский" Tag="ru" />
                  </ComboBox>
                </Grid>
                <StackPanel x:Name="ChatApiPanel" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
