                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="渠道" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,11,18,7" />
                    <StackPanel Grid.Column="1" Margin="0,4,0,0">
                      <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox x:Name="ChatProfileList" BorderThickness="0" Background="Transparent"
                                 MinHeight="76" MaxHeight="150" SelectionChanged="ChatProfileList_SelectionChanged" />
                      </Border>
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="新建渠道" MinHeight="0" Margin="0,0,6,0" Style="{StaticResource SubtleButtonStyle}"
                                  Click="NewChatProfile_Click" />
                          <Button Content="删除渠道" MinHeight="0" Margin="0,0,6,0" Style="{StaticResource SubtleButtonStyle}"
                                  Click="DeleteChatProfile_Click" />
                          <Button Content="设为当前" MinHeight="0" Style="{StaticResource SubtleButtonStyle}"
                                  Click="ActivateChatProfile_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ChatProfileHint" Grid.Column="1" Style="{StaticResource CaptionTextStyle}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="渠道名称" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ChatProfileNameText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsFieldStyle}"
                             TextChanged="ChatProfileField_Changed"
                             ToolTip="随便起名，例如「公司 DeepSeek」「本地 LM Studio」，会显示在结果和历史里。" />

                    <TextBlock Grid.Row="2" Text="接口格式" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Grid.Row="2" Grid.Column="1">
                      <ComboBox x:Name="ChatApiFormatCombo" Style="{StaticResource SettingsComboStyle}"
                                SelectionChanged="ChatApiFormatCombo_SelectionChanged"
                                ToolTip="三种格式只是接口形态不同，服务商由接口地址决定。" />
                      <TextBlock x:Name="ChatApiFormatHint" Style="{StaticResource CaptionTextStyle}"
                                 Margin="0,0,0,4" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="接口地址" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ChatApiBaseUrlText" Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingsFieldStyle}"
                             TextChanged="ChatProfileField_Changed"
