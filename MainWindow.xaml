            <Grid Margin="24,0">
              <TextBlock x:Name="SettingsStatus" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="测试翻译" Margin="0,0,8,0" Click="TestTranslation_Click" />
                <Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}" Click="SaveSettings_Click" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{StaticResource SurfaceMutedBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <TextBlock x:Name="FooterStatus" VerticalAlignment="Center" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" />
      </Grid>
    </Border>

    <Border x:Name="FileDropOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed"
            Margin="18" Background="#F018221F" BorderBrush="{StaticResource AccentLineBrush}"
            BorderThickness="2" CornerRadius="8" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="8" Background="#2BFFFFFF">
          <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="松开以添加到任务中心" Margin="0,16,0,0" FontSize="17"
                   Foreground="White" FontWeight="SemiBold" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
