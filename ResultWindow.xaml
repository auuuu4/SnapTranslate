<Window x:Class="SnapTranslate.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="识别与翻译" Width="640" Height="580" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceBrush}" Topmost="True">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel>
        <TextBlock Text="识别与翻译" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock x:Name="ProviderText" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="0,20,0,0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
          <Grid Margin="14,0">
            <TextBlock Text="识别文本" Style="{StaticResource SectionTitleTextStyle}" FontSize="13" VerticalAlignment="Center" />
            <Button Content="复制" Style="{StaticResource SubtleButtonStyle}" Padding="9,4"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopySource_Click" />
          </Grid>
        </Border>
        <TextBox x:Name="SourceText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 Style="{StaticResource BorderlessTextBoxStyle}" Padding="14,12" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentLineBrush}"
                BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
          <Grid Margin="14,0">
            <TextBlock Text="翻译结果" Style="{StaticResource SectionTitleTextStyle}" FontSize="13" VerticalAlignment="Center" />
            <Button Content="复制" Style="{StaticResource SubtleButtonStyle}" Padding="9,4"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyTranslation_Click" />
          </Grid>
        </Border>
        <TextBox x:Name="TranslationText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 Style="{StaticResource BorderlessTextBoxStyle}" Padding="14,12" />
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="2,10,2,0" FontSize="12"
               Foreground="{StaticResource MutedBrush}" />
  </Grid>
</Window>
